<Project>
  <!-- Every package version lives here, pinned exactly. Ask before adding a package (DESIGN.md, section 14). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="[2.0.1]" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="[2.0.1]" />
    <!-- Media Foundation decoding and WASAPI capture; brings NAudio.Core. -->
    <PackageVersion Include="NAudio.Wasapi" Version="[3.3.0]" />
    <PackageVersion Include="NAudio.Core" Version="[3.3.0]" />
  </ItemGroup>
  <ItemGroup Label="Tests only; never shipped">
    <PackageVersion Include="xunit.v3" Version="[4.0.2]" />
  </ItemGroup>
</Project>
