<Window x:Class="Talktrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Talktrace.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="Talktrace.ico"
        Width="900"
        Height="700"
        MinWidth="800"
        MinHeight="560"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragOver"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDrop="OnPreviewDrop">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo />
  </Window.TaskbarItemInfo>

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding ChooseRecordingCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>

  <TabControl x:Name="Tabs" Margin="12,8,12,0" SelectedIndex="{Binding SelectedTab}" SelectionChanged="OnTabChanged">
  <TabItem Header="Transcribe a file" AutomationProperties.AutomationId="FileTab">
  <Grid Margin="12,16,12,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Missing models -->
    <Border Grid.Row="0"
            Margin="0,0,0,16"
            Padding="16,12"
            CornerRadius="6"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            Visibility="{Binding HasModelsMessage, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button Margin="16,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding OpenModelsFolderCommand}"
                Content="Open models folder"
                DockPanel.Dock="Right" />
        <TextBlock VerticalAlignment="Center"
                   AutomationProperties.AutomationId="ModelsMessage"
                   Text="{Binding ModelsMessage}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- 1. File -->
    <Grid Grid.Row="1" MinHeight="76">
      <Rectangle Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 RadiusX="6"
                 RadiusY="6"
                 Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                 StrokeDashArray="4 3"
                 StrokeThickness="1.5" />
      <DockPanel Margin="20,12">
        <Button VerticalAlignment="Center"
                Command="{Binding ChooseRecordingCommand}"
                Content="Choose recording…"
                DockPanel.Dock="Right"
                ToolTip="Ctrl+O" />
        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock FontSize="16"
                     FontWeight="SemiBold"
                     Text="{Binding RecordingTitle}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{Binding RecordingDetails}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Grid>

    <!-- 2. Options -->
    <WrapPanel Grid.Row="2" Margin="0,16,0,0" IsEnabled="{Binding IsIdle}">
      <StackPanel Margin="0,0,16,8">
        <TextBlock Style="{StaticResource Caption}" Text="Speakers" />
        <ComboBox Width="200"
                  DisplayMemberPath="Label"
                  ItemsSource="{Binding SpeakerChoices}"
                  SelectedItem="{Binding SelectedSpeakers}" />
      </StackPanel>
      <StackPanel Margin="0,0,16,8" Visibility="{Binding ShowModelChoice, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource Caption}" Text="Model" />
        <ComboBox Width="200"
                  DisplayMemberPath="Label"
                  ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile}">
          <ComboBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
              <Setter Property="IsEnabled" Value="{Binding IsInstalled}" />
            </Style>
          </ComboBox.ItemContainerStyle>
        </ComboBox>
      </StackPanel>
      <CheckBox Margin="0,0,16,8"
                VerticalAlignment="Bottom"
                Content="Include timestamps"
                IsChecked="{Binding IncludeTimestamps}" />
      <ToggleButton x:Name="AdvancedToggle"
                    Margin="0,0,0,8"
                    VerticalAlignment="Bottom"
                    Content="Advanced" />
    </WrapPanel>

    <!-- Advanced -->
    <WrapPanel Grid.Row="3"
               Margin="0,4,0,0"
               IsEnabled="{Binding IsIdle}"
               Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource Visible}}">
      <StackPanel Margin="0,0,16,8"
                  ToolTip="Voices closer than this are one speaker. Lower finds more speakers, higher fewer. Default 0.6.">
        <TextBlock Style="{StaticResource Caption}" Text="Clustering threshold" />
        <TextBox Width="120" Text="{Binding ClusteringThreshold, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Margin="0,0,16,8" ToolTip="Processor threads for transcription and speaker identification.">
        <TextBlock Style="{StaticResource Caption}" Text="Threads" />
        <TextBox Width="120" Text="{Binding Threads, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Margin="0,0,16,8" ToolTip="After this long, a stretch of speech is split at the next short pause.">
        <TextBlock Style="{StaticResource Caption}" Text="Longest speech segment (s)" />
        <TextBox Width="120" Text="{Binding MaxSpeechSeconds, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Margin="0,0,16,8" ToolTip="The most audio the speech model transcribes at once.">
        <TextBlock Style="{StaticResource Caption}" Text="Longest chunk (s)" />
        <TextBox Width="120" Text="{Binding MaxChunkSeconds, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <Button Margin="0,0,8,8"
              VerticalAlignment="Bottom"
              Command="{Binding ResetAdvancedCommand}"
              Content="Reset" />
      <Button Margin="0,0,0,8"
              VerticalAlignment="Bottom"
              Command="{Binding OpenLogFolderCommand}"
              Content="Open log folder"
              ToolTip="The log records what Talktrace did and any errors, never what was said." />
    </WrapPanel>

    <!-- 3. Transcribe and 4. Progress -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid>
        <Button MinWidth="120"
                MinHeight="36"
                HorizontalAlignment="Stretch"
                Command="{Binding TranscribeCommand}"
                Content="Transcribe"
                Style="{DynamicResource AccentButtonStyle}"
                Visibility="{Binding IsIdle, Converter={StaticResource Visible}}" />
        <Button MinWidth="120"
                MinHeight="36"
                HorizontalAlignment="Stretch"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                ToolTip="Esc"
                Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
      </Grid>
      <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock Margin="16,0,0,0"
                     DockPanel.Dock="Right"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     AutomationProperties.AutomationId="TimeText"
                     Text="{Binding TimeText}" />
          <TextBlock AutomationProperties.AutomationId="StageText" Text="{Binding StageText}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <ProgressBar Margin="0,8,0,0"
                     IsIndeterminate="{Binding ProgressIsIndeterminate}"
                     Maximum="1"
                     Visibility="{Binding IsRunning, Converter={StaticResource Visible}}"
                     Value="{Binding ProgressValue, Mode=OneWay}" />
      </StackPanel>
    </Grid>

    <!-- Errors -->
    <Border Grid.Row="5"
            Margin="0,16,0,0"
            Padding="16,12"
            CornerRadius="6"
            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
            Visibility="{Binding HasError, Converter={StaticResource Visible}}">
      <DockPanel>
        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right">
          <Hyperlink Command="{Binding OpenLogFolderCommand}">Open log folder</Hyperlink>
        </TextBlock>
        <TextBlock Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Right"
                   Visibility="{Binding HasErrorDetails, Converter={StaticResource Visible}}">
          <Hyperlink Command="{Binding CopyErrorDetailsCommand}">Copy details</Hyperlink>
        </TextBlock>
        <TextBlock VerticalAlignment="Center"
                   AutomationProperties.AutomationId="ErrorMessage"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <!-- 5. Transcript and 6. Speakers panel -->
    <Grid Grid.Row="6" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="1"
              Width="280"
              Margin="16,0,0,0"
              Padding="4,8"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              IsEnabled="{Binding IsIdle}"
              Visibility="{Binding HasSpeakers, Converter={StaticResource Visible}}">
        <DockPanel>
          <TextBlock Margin="12,0,12,8"
                     DockPanel.Dock="Top"
                     FontWeight="SemiBold"
                     Text="Speakers" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl AutomationProperties.AutomationId="SpeakersList" ItemsSource="{Binding Speakers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:SpeakerRow}">
                  <Grid Margin="12,4,12,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock AutomationProperties.AutomationId="SpeakerLabel" Style="{StaticResource Caption}" Text="{Binding Label}" />
                    <Grid Grid.Row="1">
                      <TextBox AutomationProperties.AutomationId="SpeakerName"
                               AutomationProperties.Name="{Binding Label, StringFormat='Name for {0}'}"
                               PreviewKeyDown="OnSpeakerNameKeyDown"
                               Text="{Binding NameText, UpdateSourceTrigger=LostFocus}" />
                      <TextBlock Margin="12,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                 IsHitTestVisible="False"
                                 Text="Type a name">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NameText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Width="36"
                            Margin="8,0,0,0"
                            VerticalAlignment="Stretch"
                            AutomationProperties.AutomationId="PlaySample"
                            Command="{Binding PlaySampleCommand}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Visibility="{Binding CanPlay, Converter={StaticResource Visible}}">
                      <Button.Style>
                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                          <Setter Property="Content" Value="&#xE768;" />
                          <Setter Property="ToolTip" Value="Play a sample" />
                          <Setter Property="AutomationProperties.Name" Value="{Binding Label, StringFormat='Play a sample of {0}'}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                              <Setter Property="Content" Value="&#xE71A;" />
                              <Setter Property="ToolTip" Value="Stop" />
                              <Setter Property="AutomationProperties.Name" Value="{Binding Label, StringFormat='Stop the sample of {0}'}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Margin="0,4,0,0"
                               AutomationProperties.AutomationId="SpeakerNameError"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding NameError}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNameError, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Row="3"
                               Grid.ColumnSpan="2"
                               Margin="0,6,0,0"
                               MaxHeight="60"
                               AutomationProperties.AutomationId="SpeakerSample"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Sample}"
                               TextTrimming="WordEllipsis"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <TextBox x:Name="Transcript"
               Padding="12,10"
               VerticalContentAlignment="Top"
               AcceptsReturn="True"
               IsReadOnly="{Binding IsTranscriptReadOnly}"
               Text="{Binding TranscriptText, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />
      <TextBlock Margin="16,12"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 IsHitTestVisible="False"
                 Text="The transcript appears here."
                 Visibility="{Binding IsTranscriptReadOnly, Converter={StaticResource Visible}}" />
    </Grid>

    <!-- 7. Actions -->
    <DockPanel Grid.Row="7" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Command="{Binding SaveCommand}" Content="Save" ToolTip="Ctrl+S" />
        <Button Margin="8,0,0,0" Command="{Binding SaveAsCommand}" Content="Save as…" />
        <Button Margin="8,0,0,0" Command="{Binding CopyAllCommand}" Content="Copy all" />
        <Button Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" Content="Open folder" />
      </StackPanel>
      <TextBlock Margin="0,0,16,0"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="StatusText"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="{Binding StatusText}"
                 TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
  </TabItem>

  <!-- Record a meeting (DESIGN.md section 9, Recording screen) -->
  <TabItem Header="Record a meeting" AutomationProperties.AutomationId="RecordTab">
    <ScrollViewer DataContext="{Binding Record}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12,16,12,20" MaxWidth="760" HorizontalAlignment="Left">

        <!-- 1. Mode -->
        <TextBlock Style="{StaticResource SectionHeading}" Text="How are you meeting?" />
        <StackPanel IsEnabled="{Binding IsIdle}">
          <RadioButton AutomationProperties.AutomationId="ModeInPerson" GroupName="Mode" IsChecked="{Binding IsInPerson}">
            <TextBlock><Run FontWeight="SemiBold" Text="In person" />: microphone only</TextBlock>
          </RadioButton>
          <RadioButton Margin="0,4,0,0" AutomationProperties.AutomationId="ModeCallHeadphones" GroupName="Mode" IsChecked="{Binding IsCallHeadphones}">
            <TextBlock><Run FontWeight="SemiBold" Text="Online call, headphones" />: your voice and the call as separate tracks</TextBlock>
          </RadioButton>
          <RadioButton Margin="0,4,0,0" AutomationProperties.AutomationId="ModeCallSpeakers" GroupName="Mode" IsChecked="{Binding IsCallSpeakers}">
            <TextBlock><Run FontWeight="SemiBold" Text="Online call, speakers" />: as headphones, and removes call voices your mic picks up</TextBlock>
          </RadioButton>
        </StackPanel>

        <!-- 2. Devices with level meters -->
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Text="Microphone" />
          <ComboBox Grid.Column="1"
                    AutomationProperties.AutomationId="MicrophoneList"
                    AutomationProperties.Name="Microphone"
                    IsEnabled="{Binding IsIdle}"
                    ItemsSource="{Binding Microphones}"
                    SelectedItem="{Binding SelectedMicrophone}"
                    DisplayMemberPath="Label" />
          <ProgressBar Grid.Column="2"
                       Height="8"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="MicrophoneLevel"
                       AutomationProperties.Name="Microphone level"
                       Maximum="1"
                       Value="{Binding MicrophoneLevel, Mode=OneWay}" />
          <TextBlock Grid.Row="1"
                     Margin="0,12,16,0"
                     VerticalAlignment="Center"
                     Text="Call audio"
                     Visibility="{Binding IsCall, Converter={StaticResource Visible}}" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,12,0,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource Note}"
                     Text="Everything your PC plays, on any device, except Talktrace"
                     Visibility="{Binding IsCall, Converter={StaticResource Visible}}" />
          <ProgressBar Grid.Row="1"
                       Grid.Column="2"
                       Height="8"
                       Margin="16,12,0,0"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="SystemLevel"
                       AutomationProperties.Name="Call audio level"
                       Maximum="1"
                       Value="{Binding SystemLevel, Mode=OneWay}"
                       Visibility="{Binding IsCall, Converter={StaticResource Visible}}" />
        </Grid>
        <Border Margin="0,12,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding HasMicrophoneNote, Converter={StaticResource Visible}}">
          <TextBlock AutomationProperties.AutomationId="MicrophoneNote" Text="{Binding MicrophoneNote}" TextWrapping="Wrap" />
        </Border>

        <!-- 3. Start, Pause/Resume, Stop, elapsed time and the recording indicator -->
        <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
          <Button MinWidth="120"
                  MinHeight="36"
                  AutomationProperties.AutomationId="StartButton"
                  Command="{Binding StartCommand}"
                  Content="Start recording"
                  Style="{DynamicResource AccentButtonStyle}"
                  Visibility="{Binding IsIdle, Converter={StaticResource Visible}}" />
          <Button MinWidth="100"
                  MinHeight="36"
                  AutomationProperties.AutomationId="PauseButton"
                  Command="{Binding PauseCommand}"
                  Content="Pause"
                  Visibility="{Binding IsRecordingNotPaused, Converter={StaticResource Visible}}" />
          <Button MinWidth="100"
                  MinHeight="36"
                  AutomationProperties.AutomationId="ResumeButton"
                  Command="{Binding ResumeCommand}"
                  Content="Resume"
                  Visibility="{Binding IsPaused, Converter={StaticResource Visible}}" />
          <Button MinWidth="100"
                  MinHeight="36"
                  Margin="8,0,0,0"
                  AutomationProperties.AutomationId="StopButton"
                  Command="{Binding StopCommand}"
                  Content="Stop"
                  Visibility="{Binding IsRecording, Converter={StaticResource Visible}}" />
          <Border Margin="20,0,0,0"
                  Padding="10,3"
                  VerticalAlignment="Center"
                  CornerRadius="4"
                  Visibility="{Binding IsRecording, Converter={StaticResource Visible}}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#C42B1C" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Background" Value="#9D5D00" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock AutomationProperties.AutomationId="RecordingBadge" Foreground="White" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="● Recording" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                      <Setter Property="Text" Value="Paused" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <TextBlock Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="ElapsedText"
                     FontSize="16"
                     Text="{Binding ElapsedText}"
                     Visibility="{Binding IsRecording, Converter={StaticResource Visible}}" />
          <TextBlock Margin="16,0,0,0"
                     VerticalAlignment="Center"
                     Text="Starting…"
                     Visibility="{Binding IsStarting, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- 4. Standing notes -->
        <StackPanel Margin="0,12,0,0">
          <TextBlock Style="{StaticResource Note}" Text="Let participants know you're recording." />
          <TextBlock Style="{StaticResource Note}" Text="Muting in Teams doesn't pause Talktrace; use Pause." />
          <TextBlock Style="{StaticResource Note}"
                     Text="Everything your PC plays is recorded, including notification sounds."
                     Visibility="{Binding IsCall, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- 5. Free disk space -->
        <TextBlock Margin="0,8,0,0" AutomationProperties.AutomationId="FreeSpaceText" Text="{Binding FreeSpaceText}">
          <TextBlock.Style>
            <Style BasedOn="{StaticResource Note}" TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowOnSpace}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Errors and warnings -->
        <Border Margin="0,16,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="{Binding HasError, Converter={StaticResource Visible}}">
          <TextBlock AutomationProperties.AutomationId="RecordError" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <ItemsControl Margin="0,8,0,0" AutomationProperties.AutomationId="RecordWarnings" ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,4,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Recording settings (section 3) -->
        <Border Margin="0,24,0,0"
                Padding="16,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionHeading}" Text="Settings" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Your name" />
              <TextBox Width="200"
                       AutomationProperties.AutomationId="YourName"
                       AutomationProperties.Name="Your name"
                       Text="{Binding YourName, UpdateSourceTrigger=LostFocus}"
                       ToolTip="In online calls, your turns are labelled with this name." />
            </StackPanel>
            <CheckBox Margin="0,10,0,0"
                      AutomationProperties.AutomationId="TranscribeWhenStopped"
                      Content="Transcribe automatically when I stop"
                      IsChecked="{Binding TranscribeWhenStopped}" />
            <CheckBox Margin="0,6,0,0"
                      AutomationProperties.AutomationId="KeepRecordings"
                      Content="Keep recordings after transcribing"
                      IsChecked="{Binding KeepRecordings}"
                      ToolTip="When off, a recording goes to the Recycle Bin once its transcript is saved." />
            <DockPanel Margin="0,10,0,0">
              <Button Margin="8,0,0,0" Command="{Binding OpenRecordingsFolderCommand}" Content="Open folder" DockPanel.Dock="Right" />
              <Button Margin="12,0,0,0" Command="{Binding ChangeFolderCommand}" Content="Change…" DockPanel.Dock="Right" />
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="Save recordings in:" />
                <Run AutomationProperties.AutomationId="RecordingsFolder" Text="{Binding RecordingsFolder, Mode=OneWay}" />
              </TextBlock>
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </TabItem>
  </TabControl>
</Window>
