<Window x:Class="Talktrace.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talktrace"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="Body" Margin="0,8,0,0" TextWrapping="Wrap" />
    <StackPanel x:Name="Buttons" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal" />
  </StackPanel>
</Window>
